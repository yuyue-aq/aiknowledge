# Local model weights are runtime assets and must not be committed.
/models/

# Local test and package-manager caches.
/.uv-cache/
/aiknowledge/.pytest_cache/
/aiknowledge/.uv-cache/
/aiknowledge/.venv-local/
/aiknowledge/runtime-logs/

# Local credentials and developer settings. Commit templates only.
.env
.env.*
!.env.example
!.env.*.example
.idea/

# Backups can contain the complete database and private source documents.
backups/
*.dump

# Browser sessions, reports and other local tool output.
.playwright-mcp/
playwright-report/
test-results/
.auth/
.firecrawl/
runtime-logs/
*.log
.pytest_cache/

# Local evaluation runs and disposable build contexts; release evidence lives
# in eval/v2/releases instead of these machine-specific directories.
/output/
/tmp/
/eval/v2/runtime/*-restored.jpg
/eval/v2/runtime/omission-*.json
/eval/v2/runtime/request-proxy-check.json
/eval/v2/runtime/retrieval-timeout-check.json
/eval/v2/runtime/space-list-check.json
/eval/v2/runtime/public-password-session-check.json

# Explicit source-controlled evidence, overriding generic global build ignores.
!/eval/v2/releases/
!/eval/v2/releases/**
