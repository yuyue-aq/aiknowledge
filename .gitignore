# Local model weights are runtime assets and must not be committed.
/models/

# Local test and package-manager caches.
/.uv-cache/
/aiknowledge/.pytest_cache/
/aiknowledge/.uv-cache/
/aiknowledge/.venv-local/
/aiknowledge/runtime-logs/

# Local credentials and developer settings. Commit templates only.
.env
.env.*
!.env.example
!.env.*.example
.idea/

# Backups can contain the complete database and private source documents.
backups/
*.dump

# Browser sessions, reports and other local tool output.
.playwright-mcp/
playwright-report/
test-results/
.auth/
.firecrawl/
runtime-logs/
*.log
.pytest_cache/
