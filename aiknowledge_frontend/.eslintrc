{
  "extends": ["taro/react"],
  "rules": {
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [{
    "files": ["src/components/EvaluationView.tsx", "src/components/RetrievalView.tsx", "src/components/ChunkPreviewView.tsx"],
    "rules": { "react/forbid-elements": "off" }
  }]
}
