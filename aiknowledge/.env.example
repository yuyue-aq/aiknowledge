# Never put a real key in source control. Copy this file to .env locally.
AIKNOWLEDGE_DEEPSEEK_API_KEY=
AIKNOWLEDGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
AIKNOWLEDGE_DEEPSEEK_MODEL=deepseek-flash
AIKNOWLEDGE_DEEPSEEK_THINKING_ENABLED=false
AIKNOWLEDGE_DEEPSEEK_MAX_RETRIES=1

# BAAI/bge-large-zh-v1.5 returns 1024-dimensional vectors.
AIKNOWLEDGE_BGE_MODEL_NAME=BAAI/bge-large-zh-v1.5
AIKNOWLEDGE_BGE_EMBEDDING_DIMENSION=1024
AIKNOWLEDGE_BGE_USE_FP16=false
AIKNOWLEDGE_BGE_BATCH_SIZE=8
AIKNOWLEDGE_BGE_TIMEOUT_SECONDS=600
AIKNOWLEDGE_BGE_MAX_RETRIES=1
# Each Celery child owns a local BGE model; keep concurrency modest on CPU hosts.
AIKNOWLEDGE_WORKER_CONCURRENCY=4
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Local API processes use localhost; Docker Compose overrides this with postgres.
AIKNOWLEDGE_DATABASE_URL=postgresql+asyncpg://aiknowledge:aiknowledge@localhost:5432/aiknowledge
AIKNOWLEDGE_DATABASE_POOL_SIZE=5
AIKNOWLEDGE_DATABASE_MAX_OVERFLOW=10

AIKNOWLEDGE_REDIS_URL=redis://localhost:6379/0
AIKNOWLEDGE_MINIO_ENDPOINT=localhost:9000
AIKNOWLEDGE_MINIO_ACCESS_KEY=aiknowledge
AIKNOWLEDGE_MINIO_SECRET_KEY=replace-with-a-local-development-secret
AIKNOWLEDGE_MINIO_BUCKET=aiknowledge-private
AIKNOWLEDGE_MINIO_SECURE=false
AIKNOWLEDGE_SHARE_TOKEN_PEPPER=replace-with-a-long-random-local-secret
AIKNOWLEDGE_PUBLIC_SESSION_SECRET=replace-with-a-long-random-local-secret
AIKNOWLEDGE_PUBLIC_SESSION_TTL_SECONDS=3600
AIKNOWLEDGE_PUBLIC_SESSION_COOKIE_SECURE=false
AIKNOWLEDGE_AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
AIKNOWLEDGE_AUTH_REFRESH_TOKEN_PEPPER=replace-with-a-long-random-refresh-secret
AIKNOWLEDGE_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AIKNOWLEDGE_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AIKNOWLEDGE_AUTH_REQUIRED=true
AIKNOWLEDGE_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AIKNOWLEDGE_PUBLIC_SESSION_RATE_LIMIT=20
AIKNOWLEDGE_PUBLIC_QUESTION_RATE_LIMIT=60
AIKNOWLEDGE_CORS_ALLOWED_ORIGINS=http://localhost:10086,http://127.0.0.1:10086
AIKNOWLEDGE_DOCUMENT_MAX_FILE_BYTES=20971520
AIKNOWLEDGE_SOURCE_SYNC_TIMEOUT_SECONDS=30
AIKNOWLEDGE_SOURCE_SYNC_MAX_BYTES=20971520

# Docker Compose host ports and the frontend build-time API address.
API_PORT=8000
FRONTEND_PORT=10086
TARO_APP_API_BASE=http://localhost:8000/api/v1

# Leave this unset until it has been calibrated against the evaluation set.
# AIKNOWLEDGE_EVIDENCE_MINIMUM_SCORE=
